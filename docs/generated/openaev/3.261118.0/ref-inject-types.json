    {
      "title": "Expectations",
      "text": "The expectations the contracts offer, each with a score of 100 to start with. An expectation that nothing validates before it expires fails. **Expires after** is the default; the keys are read in order, and the first one set wins.",
      "columns": [
        "Expectation",
        "Type",
        "Offered by",
        "Expires after",
        "Configuration keys"
      ],
      "rows": [
        {
          "key": "expectation:PREVENTION",
          "cells": [
            "**Prevention**",
            "`PREVENTION`",
            "the phishing actions",
            "6 hours",
            "`openaev.expectation.prevention.expiration-time`, then `openaev.expectation.technical.expiration-time`"
          ]
        },
        {
          "key": "expectation:DETECTION",
          "cells": [
