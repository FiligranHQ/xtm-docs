{
  "source": "FiligranHQ/xtm-docker@b9c11dc",
  "modules": [
    {
      "id": "xtm-one",
      "label": "XTM One",
      "icon": "LogoXTMOne",
      "summary": "The agentic AI orchestration layer at the center of the platform, its web application and its worker.",
      "requires": [],
      "services": [
        "xtm-one",
        "xtm-one-worker"
      ],
      "extras": [],
      "needs": [
        "xtm-one-db-init",
        "pgsql",
        "redis",
        "minio"
      ],
      "url": "http://localhost:8090",
      "health": "http://localhost:8090/api/health"
    },
    {
      "id": "opencti",
      "label": "OpenCTI",
      "icon": "LogoOpenCTI",
      "summary": "The cyber threat intelligence platform and its worker.",
      "requires": [],
      "services": [
        "opencti",
        "worker"
      ],
      "extras": [
        {
          "id": "opencti-connectors",
          "label": "Default connectors",
          "summary": "File imports and exports, document analysis, the OpenCTI datasets and MITRE ATT&CK.",
          "services": [
            "connector-export-file-stix",
            "connector-export-file-csv",
            "connector-export-file-txt",
            "connector-import-file-stix",
            "connector-import-document",
            "connector-import-file-yara",
            "connector-analysis",
            "connector-import-external-reference",
            "connector-opencti",
            "connector-mitre"
          ],
          "needs": []
        },
        {
          "id": "composer",
          "label": "XTM Composer",
          "summary": "Deploys and runs integrations from the interface of OpenCTI and OpenAEV.",
          "services": [
            "xtm-composer"
          ],
          "needs": [
            "rsa-key-generator",
            "rabbitmq"
          ]
        }
      ],
      "needs": [
        "redis",
        "elasticsearch",
        "minio",
        "rabbitmq"
      ],
      "url": "http://localhost:8080",
      "health": "http://localhost:8080/health?health_access_key=$OPENCTI_HEALTHCHECK_ACCESS_KEY"
    },
    {
      "id": "openaev",
      "label": "OpenAEV",
      "icon": "LogoOpenAEV",
      "summary": "The adversarial exposure validation platform.",
      "requires": [],
      "services": [
        "openaev"
      ],
      "extras": [
        {
          "id": "openaev-integrations",
          "label": "Default collectors and injectors",
          "summary": "MITRE ATT&CK, the OpenAEV datasets, Atomic Red Team, NVD CVE, Nmap and Nuclei.",
          "services": [
            "collector-mitre-attack",
            "collector-openaev",
            "collector-atomic-red-team",
            "collector-nvd-nist-cve",
            "injector-nmap",
            "injector-nuclei"
          ],
          "needs": []
        },
        {
          "id": "composer",
          "label": "XTM Composer",
          "summary": "Deploys and runs integrations from the interface of OpenCTI and OpenAEV.",
          "services": [
            "xtm-composer"
          ],
          "needs": [
            "rsa-key-generator",
            "rabbitmq"
          ]
        }
      ],
      "needs": [
        "pgsql",
        "minio",
        "rabbitmq",
        "elasticsearch"
      ],
      "url": "http://localhost:8081",
      "health": "http://localhost:8081/api/health?health_access_key=$OPENAEV_HEALTHCHECK_KEY"
    },
    {
      "id": "opencrq",
      "label": "OpenCRQ",
      "icon": "LogoOpenCRQ",
      "summary": "Cyber risk quantification, fed by OpenCTI and OpenAEV, registered with XTM One.",
      "requires": [],
      "services": [
        "opencrq"
      ],
      "extras": [],
      "needs": [
        "opencrq-db-init",
        "pgsql",
        "opencrq-bucket-init",
        "minio"
      ],
      "url": "http://localhost:8082"
    }
  ],
  "shared": {
    "elasticsearch": {
      "label": "Elasticsearch",
      "icon": "Server",
      "role": "Stores and searches the knowledge of OpenCTI and OpenAEV",
      "image": "elasticsearch:8.19.23",
      "ports": [
        "9200:9200"
      ]
    },
    "redis": {
      "label": "Redis",
      "icon": "Activity",
      "role": "Cache, sessions and live events",
      "image": "redis:8.8.3",
      "ports": [
        "6379:6379"
      ]
    },
    "rabbitmq": {
      "label": "RabbitMQ",
      "icon": "ArrowLeftRight",
      "role": "Queues between platforms, workers and integrations",
      "image": "rabbitmq:4.3-management",
      "ports": [
        "5672:5672",
        "15672:15672"
      ]
    },
    "minio": {
      "label": "S3 storage",
      "icon": "Boxes",
      "role": "Files, imports and exports (RustFS, S3 compatible)",
      "image": "rustfs/rustfs:1.0.4",
      "ports": [
        "9000:9000"
      ]
    },
    "pgsql": {
      "label": "PostgreSQL",
      "icon": "Server",
      "role": "Database of OpenAEV, OpenCRQ and XTM One (pgvector)",
      "image": "pgvector/pgvector:pg17",
      "ports": []
    }
  },
  "init": {
    "rsa-key-generator": "Generates the RSA key XTM Composer encrypts the integrations' configurations with.",
    "xtm-one-db-init": "Creates the XTM One database and its role in PostgreSQL.",
    "opencrq-db-init": "Creates the OpenCRQ database in PostgreSQL.",
    "opencrq-bucket-init": "Creates the OpenCRQ bucket in the S3 storage, which OpenCRQ does not create in production."
  },
